# Compile coverage for the MediaTek UFS host controller and M-PHY drivers.
# Runtime probe uses the injected vendor DT nodes; this config alone does not
# establish UFS link, storage, crypto, MCQ, or runtime-PM support.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=y

# Recovery-only diagnostics need pstore to survive the deliberate panic and
# LK reboot. Without these explicit values, olddefconfig left console/pmsg
# disabled and ramoops as a module, making successful probe runs invisible.
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# MT6873 pinctrl supplies the PMIC interrupt through the MediaTek EINT block.
# MFD_MT6397 and REGULATOR_MT6397 provide the MT6359 PMIC/regulator chain needed
# by UFS and other consumers.
CONFIG_PINCTRL_MT6873=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR_MT6397=y

# The formal MT6873 DTS exposes only the vendor-confirmed CONN power domain.
# Provider probe must succeed before MT8192-inherited domain nodes are exposed.
CONFIG_MTK_SCPSYS_PM_DOMAINS=y

# MTK_MMSYS registers the clk-mt6873-mm child provider. This stage exposes
# display gate clocks only; display consumers and the DISP power domain remain
# disabled until their exact reset and power sequences are validated.
# MTK_MMSYS is tristate-limited by MTK_CMDQ, so build the CMDQ support in as
# well or olddefconfig silently lowers MTK_MMSYS back to a module.
CONFIG_COMMON_CLK_MT6873=y
CONFIG_MTK_CMDQ=y
CONFIG_MTK_MMSYS=y

# Stage C0 compile-tests the MT6873 SMI common/LARB provider data. IOMMU and
# traffic-bearing display consumers remain disabled until their bank routing
# and WRR programming are separately validated.
CONFIG_MTK_SMI=y

# Stage C1 compile-tests the single main MT6873 display IOMMU provider. No
# hardware device consumes its #iommu-cells yet.
CONFIG_MTK_IOMMU=y

# I2C5 carries the MT6360 PMU, charger and Type-C TCPC. These options cover
# controller/MFD/subdriver binding only; they do not assert that MT6360
# regulator rails or USB Type-C data paths are safe to enable at runtime.
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_MFD_MT6360=y
CONFIG_CHARGER_MT6360=y
CONFIG_TYPEC=y
CONFIG_TYPEC_TCPM=y
CONFIG_TYPEC_TCPCI=y
CONFIG_TYPEC_MT6360=y

# PHY_MTK_UFS and RESET_TI_SYSCON are intentionally not listed here. They must
# be enabled by SCSI_UFS_MEDIATEK's select statements and are asserted in CI.

# The MT6873 SPI clock chain is validated through the existing mt65xx SPI
# controller. This only proves controller probe and clock acquisition, not
# peripheral transfers or board pinmux.
CONFIG_SPI=y
CONFIG_SPI_MT65XX=y

# USB host and device diagnostics are compiled together, but only one controller
# is enabled in a given injected DT so xHCI and MTU3 never contend for IPPC.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_MTK=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y

# Build the stock MediaTek DRM/DSI host in-tree so the MT6873 match data
# and component registration are compile-tested. No display consumer is
# enabled by the formal DTS at this stage.
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SAMSUNG_S6E8FC01=y

# The peripheral-only MTU3 diagnostic builds a stock CDC ACM gadget through
# configfs. This validates UDC registration and host enumeration without
# introducing a storage or Android runtime dependency.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
