diff --git a/drivers/phy/mediatek/phy-mtk-tphy.c b/drivers/phy/mediatek/phy-mtk-tphy.c
index cee2f5d..dfcfb70 100644
--- a/drivers/phy/mediatek/phy-mtk-tphy.c
+++ b/drivers/phy/mediatek/phy-mtk-tphy.c
@@ -74,6 +74,7 @@
 #define PA6_RG_U2_SQTH		GENMASK(3, 0)
 
 #define U3P_U2PHYACR4		0x020
+#define P2C_RG_USB20_DP_100K_MODE	BIT(18)
 #define P2C_RG_USB20_GPIO_CTL		BIT(9)
 #define P2C_USB20_GPIO_MODE		BIT(8)
 #define P2C_U2_GPIO_CTR_MSK	(P2C_RG_USB20_GPIO_CTL | P2C_USB20_GPIO_MODE)
@@ -111,6 +112,9 @@
 
 #define U3P_U2PHYDTM1		0x06C
 #define P2C_RG_UART_EN			BIT(16)
+#define P2C_FORCE_VBUSVALID		BIT(13)
+#define P2C_FORCE_SESSEND		BIT(12)
+#define P2C_FORCE_AVALID		BIT(10)
 #define P2C_FORCE_IDDIG		BIT(9)
 #define P2C_RG_VBUSVALID		BIT(5)
 #define P2C_RG_SESSEND			BIT(4)
@@ -288,12 +292,16 @@ enum mtk_phy_version {
  * @slew_rate_coefficient:    Coefficient for slew rate calibration
  * @version:                  PHY IP Version
  * @usb_vusb10_on:            Program RG_SSUSB_VUSB10_ON during U3 PHY setup
+ * @u2_dp_100k_mode:          Select the MT6873 U2 DP 100K mode
+ * @force_u2_session:         Force the MT6873 U2 session-valid inputs
  */
 struct mtk_phy_pdata {
 	bool avoid_rx_sen_degradation;
 	bool sw_pll_48m_to_26m;
 	bool sw_efuse_supported;
 	bool usb_vusb10_on;
+	bool u2_dp_100k_mode;
+	bool force_u2_session;
 	u8 slew_ref_clock_mhz;
 	u8 slew_rate_coefficient;
 	enum mtk_phy_version version;
@@ -851,6 +859,10 @@ static void u2_phy_instance_init(struct mtk_tphy *tphy,
 
 	mtk_phy_clear_bits(com + U3P_U2PHYACR4, P2C_U2_GPIO_CTR_MSK);
 
+	if (tphy->pdata->u2_dp_100k_mode)
+		mtk_phy_set_bits(com + U3P_U2PHYACR4,
+				 P2C_RG_USB20_DP_100K_MODE);
+
 	if (tphy->pdata->avoid_rx_sen_degradation) {
 		if (!index) {
 			mtk_phy_set_bits(com + U3P_USBPHYACR2, PA2_RG_SIF_U2PLL_FORCE_EN);
@@ -885,10 +897,20 @@ static void u2_phy_instance_power_on(struct mtk_tphy *tphy,
 	/* OTG Enable */
 	mtk_phy_set_bits(com + U3P_USBPHYACR6, PA6_RG_U2_OTG_VBUSCMP_EN);
 
+	if (tphy->pdata->force_u2_session)
+		mtk_phy_set_bits(com + U3P_U2PHYDTM1,
+				 P2C_FORCE_VBUSVALID |
+				 P2C_FORCE_AVALID |
+				 P2C_FORCE_SESSEND);
+
 	mtk_phy_set_bits(com + U3P_U2PHYDTM1, P2C_RG_VBUSVALID | P2C_RG_AVALID);
 
 	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_SESSEND);
 
+	if (tphy->pdata->force_u2_session)
+		dev_info(tphy->dev, "forced U2 session, DTM1=0x%08x\n",
+			 readl(com + U3P_U2PHYDTM1));
+
 	if (tphy->pdata->avoid_rx_sen_degradation && index) {
 		mtk_phy_set_bits(com + U3D_U2PHYDCR0, P2C_RG_SIF_U2PLL_FORCE_ON);
 
@@ -1569,6 +1591,8 @@ static const struct mtk_phy_pdata mt6873_pdata = {
 	.slew_rate_coefficient = 28,
 	.version = MTK_PHY_V2,
 	.usb_vusb10_on = true,
+	.u2_dp_100k_mode = true,
+	.force_u2_session = true,
 };
 
 static const struct of_device_id mtk_tphy_id_table[] = {
