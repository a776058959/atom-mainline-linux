diff --git a/drivers/memory/mtk-smi.c b/drivers/memory/mtk-smi.c
--- a/drivers/memory/mtk-smi.c
+++ b/drivers/memory/mtk-smi.c
@@ -92,6 +92,7 @@
 #define MTK_SMI_FLAG_SLEEP_CTL		BIT(2)
 #define MTK_SMI_FLAG_CFG_PORT_SEC_CTL	BIT(3)
 #define MTK_SMI_FLAG_MT6873_RT_TUNING	BIT(4)
+#define MTK_SMI_FLAG_CONFIG_ON_BIND	BIT(5)
 #define MTK_SMI_CAPS(flags, _x)		(!!((flags) & (_x)))
 
 struct mtk_smi_reg_pair {
@@ -155,28 +156,61 @@ struct mtk_smi_larb { /* larb: local arbiter */
 	int				larbid;
 	u32				*mmu;
 	unsigned char			*bank;
+	bool				runtime_held;
 };
 
 static int
 mtk_smi_larb_bind(struct device *dev, struct device *master, void *data)
 {
 	struct mtk_smi_larb *larb = dev_get_drvdata(dev);
 	struct mtk_smi_larb_iommu *larb_mmu = data;
-	unsigned int         i;
+	unsigned int i;
+	int ret;
 
 	for (i = 0; i < MTK_LARB_NR_MAX; i++) {
 		if (dev == larb_mmu[i].dev) {
 			larb->larbid = i;
 			larb->mmu = &larb_mmu[i].mmu;
 			larb->bank = larb_mmu[i].bank;
-			return 0;
+			break;
 		}
 	}
-	return -ENODEV;
+	if (i == MTK_LARB_NR_MAX)
+		return -ENODEV;
+
+	if (!MTK_SMI_CAPS(larb->larb_gen->flags_general,
+			  MTK_SMI_FLAG_CONFIG_ON_BIND))
+		return 0;
+
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret)
+		return ret;
+
+	ret = larb->larb_gen->config_port(dev);
+	if (!ret) {
+		larb->runtime_held = true;
+		dev_info(dev,
+			 "ATOM-DIAG-V69 larb%d thrt=%#x wrr2=%#x wrr3=%#x ostd2=%#x\n",
+			 larb->larbid,
+			 readl_relaxed(larb->base + SMI_LARB_CMD_THRT_CON),
+			 readl_relaxed(larb->base + SMI_LARB_WRR(2)),
+			 readl_relaxed(larb->base + SMI_LARB_WRR(3)),
+			 readl_relaxed(larb->base + SMI_LARB_OSTDL_PORT +
+				       (2 << 2)));
+	} else {
+		pm_runtime_put(dev);
+	}
+
+	return ret;
 }
 
 static void
 mtk_smi_larb_unbind(struct device *dev, struct device *master, void *data)
 {
-	/* Do nothing as the iommu is always enabled. */
+	struct mtk_smi_larb *larb = dev_get_drvdata(dev);
+
+	if (larb->runtime_held) {
+		pm_runtime_put(dev);
+		larb->runtime_held = false;
+	}
 }
@@ -554,6 +588,7 @@ static const struct mtk_smi_larb_gen mtk_smi_larb_mt6873 = {
 static const struct mtk_smi_larb_gen mtk_smi_larb_mt6873 = {
 	.config_port                = mtk_smi_larb_config_port_gen2_general,
-	.flags_general		    = MTK_SMI_FLAG_MT6873_RT_TUNING |
-				      MTK_SMI_FLAG_SW_FLAG,
+	.flags_general		    = MTK_SMI_FLAG_MT6873_RT_TUNING |
+				      MTK_SMI_FLAG_CONFIG_ON_BIND |
+				      MTK_SMI_FLAG_SW_FLAG,
 	.ostd			    = mtk_smi_larb_mt6873_ostd,
 };
