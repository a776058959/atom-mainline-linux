diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e8fc01.c b/drivers/gpu/drm/panel/panel-samsung-s6e8fc01.c
new file mode 100644
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e8fc01.c
@@ -0,0 +1,281 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2015 MediaTek Inc.
+ * Copyright (c) 2021 XiaoMi, Inc.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct s6e8fc01 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator *supply;
+	struct gpio_desc *enable_gpio;
+	struct gpio_desc *reset_gpio;
+	bool prepared;
+};
+
+static inline struct s6e8fc01 *to_s6e8fc01(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e8fc01, panel);
+}
+
+static void s6e8fc01_write_cmd(struct mipi_dsi_multi_context *dsi_ctx,
+			       const void *data, size_t len)
+{
+	const u8 *payload = data;
+
+	if (payload[0] < 0xb0)
+		mipi_dsi_dcs_write_buffer_multi(dsi_ctx, data, len);
+	else
+		mipi_dsi_generic_write_multi(dsi_ctx, data, len);
+}
+
+#define S6E8FC01_WRITE_SEQ(dsi_ctx, seq...)				\
+	do {								\
+		static const u8 data[] = { seq };			\
+		s6e8fc01_write_cmd(&(dsi_ctx), data, ARRAY_SIZE(data));	\
+	} while (0)
+
+static int s6e8fc01_on(struct s6e8fc01 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x11);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x35, 0x00);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xfc, 0x5a, 0x5a);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x03, 0xed);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xed, 0x40, 0x04, 0x08, 0xa8, 0x84,
+			   0x4a, 0x73, 0x02, 0x0a);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xed, 0x01, 0xcd, 0x00);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xe1, 0x93);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xdf, 0x09, 0x30, 0x95, 0x43, 0x34,
+			   0x05, 0x00, 0x27, 0x00, 0x2e, 0x4f, 0x7a, 0x77,
+			   0x10, 0x3d, 0x73, 0x00, 0xff, 0x01, 0x8b, 0x08);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xfc, 0xa5, 0xa5);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xf0, 0x5a, 0x5a);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb3, 0x11, 0x4b);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x03);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xcd, 0x04);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x04, 0xb3);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb3, 0xc0);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x06, 0xb3);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb3, 0x10);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x05, 0xb3);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb3, 0x93);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x80, 0x01);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb1, 0x01);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x01, 0xb1);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb1, 0xa7, 0x02, 0x05, 0x34, 0xcf,
+			   0x14, 0x09, 0x04, 0xae, 0x46, 0xeb, 0xd0, 0xc7,
+			   0x06, 0xc1, 0xe6, 0xe2, 0x1d, 0xff, 0xfa, 0xe1);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x16, 0xb1);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb1, 0xd9, 0x00, 0x00, 0x06, 0xcf,
+			   0x02, 0x09, 0x03, 0xc6, 0x10, 0xf4, 0xd9, 0xfd,
+			   0x00, 0xe0, 0xe8, 0xe1, 0x03, 0xff, 0xff, 0xff);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb0, 0x55, 0xb1);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xb1, 0x80);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0xf0, 0xa5, 0xa5);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x53, 0x20);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x51, 0x03, 0xff);
+	mipi_dsi_msleep(&dsi_ctx, 60);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x29);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8fc01_off(struct s6e8fc01 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x28, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	S6E8FC01_WRITE_SEQ(dsi_ctx, 0x10, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 150);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e8fc01_prepare(struct drm_panel *panel)
+{
+	struct s6e8fc01 *ctx = to_s6e8fc01(panel);
+	int ret;
+
+	if (ctx->prepared)
+		return 0;
+
+	gpiod_set_value_cansleep(ctx->enable_gpio, 1);
+	usleep_range(10000, 11000);
+
+	ret = regulator_set_voltage(ctx->supply, 3000000, 3000000);
+	if (ret)
+		goto err_disable;
+
+	ret = regulator_enable(ctx->supply);
+	if (ret)
+		goto err_disable;
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+
+	ret = s6e8fc01_on(ctx);
+	if (ret)
+		goto err_power_off;
+
+	ctx->prepared = true;
+	return 0;
+
+err_power_off:
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	regulator_disable(ctx->supply);
+err_disable:
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	return ret;
+}
+
+static int s6e8fc01_unprepare(struct drm_panel *panel)
+{
+	struct s6e8fc01 *ctx = to_s6e8fc01(panel);
+	int ret;
+
+	if (!ctx->prepared)
+		return 0;
+
+	ret = s6e8fc01_off(ctx);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	gpiod_set_value_cansleep(ctx->enable_gpio, 0);
+	regulator_disable(ctx->supply);
+	ctx->prepared = false;
+
+	return ret;
+}
+
+static const struct drm_display_mode s6e8fc01_mode = {
+	.clock = 179222,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 48,
+	.hsync_end = 1080 + 48 + 14,
+	.htotal = 1080 + 48 + 14 + 22,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 21,
+	.vsync_end = 2400 + 21 + 2,
+	.vtotal = 2400 + 21 + 2 + 9,
+	.width_mm = 71,
+	.height_mm = 153,
+};
+
+static int s6e8fc01_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+
+	mode = drm_mode_duplicate(connector->dev, &s6e8fc01_mode);
+	if (!mode)
+		return -ENOMEM;
+
+	drm_mode_set_name(mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	connector->display_info.width_mm = mode->width_mm;
+	connector->display_info.height_mm = mode->height_mm;
+	drm_mode_probed_add(connector, mode);
+
+	return 1;
+}
+
+static const struct drm_panel_funcs s6e8fc01_panel_funcs = {
+	.prepare = s6e8fc01_prepare,
+	.unprepare = s6e8fc01_unprepare,
+	.get_modes = s6e8fc01_get_modes,
+};
+
+static int s6e8fc01_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e8fc01 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e8fc01, panel,
+				   &s6e8fc01_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supply = devm_regulator_get(dev, "power");
+	if (IS_ERR(ctx->supply))
+		return dev_err_probe(dev, PTR_ERR(ctx->supply),
+				     "Failed to get power supply\n");
+
+	ctx->enable_gpio = devm_gpiod_get(dev, "enable", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->enable_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->enable_gpio),
+				     "Failed to get enable GPIO\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->hs_rate = 1098000000;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO |
+			  MIPI_DSI_MODE_VIDEO_SYNC_PULSE |
+			  MIPI_DSI_MODE_LPM |
+			  MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e8fc01_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e8fc01 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e8fc01_of_match[] = {
+	{ .compatible = "samsung,s6e8fc01" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e8fc01_of_match);
+
+static struct mipi_dsi_driver s6e8fc01_driver = {
+	.probe = s6e8fc01_probe,
+	.remove = s6e8fc01_remove,
+	.driver = {
+		.name = "panel-samsung-s6e8fc01",
+		.of_match_table = s6e8fc01_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e8fc01_driver);
+
+MODULE_AUTHOR("a776058959 <a776058959@users.noreply.github.com>");
+MODULE_DESCRIPTION("Samsung S6E8FC01 AMOLED DSI panel");
+MODULE_LICENSE("GPL");
