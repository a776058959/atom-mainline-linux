diff --git a/drivers/pmdomain/mediatek/mt6873-pm-domains.h b/drivers/pmdomain/mediatek/mt6873-pm-domains.h
--- a/drivers/pmdomain/mediatek/mt6873-pm-domains.h
+++ b/drivers/pmdomain/mediatek/mt6873-pm-domains.h
@@ -7,10 +7,10 @@
 /*
  * MT6873 power-domain support.
  *
- * Only CONN is described here for now. The vendor MT6873 power driver has no
- * pre-clock for CONN, and CONN must stay default-off until its consumers are
- * brought up. Other domains require their real MT6873 clock providers first;
- * do not reuse MT8192 domain clocks merely because the register offsets match.
+ * CONN and DIS are described here. Both remain default-off until their
+ * consumers are brought up. DIS uses the MT6873 vendor power-control offsets,
+ * status bit, SRAM bits and bus-protection sequence below; its clock topology
+ * comes from the MT6873 topckgen and MMSYS providers in the board DTS.
  */
 static enum scpsys_bus_prot_block scpsys_bus_prot_blocks_mt6873[] = {
 	BUS_PROT_BLOCK_INFRA
@@ -49,6 +50,43 @@ static const struct scpsys_domain_data scpsys_domain_data_mt6873[] = {
 		},
 		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
 	},
+	[MT6873_POWER_DOMAIN_DIS] = {
+		.name = "disp",
+		.sta_mask = BIT(20),
+		.ctl_offs = 0x0350,
+		.pwr_sta_offs = 0x016c,
+		.pwr_sta2nd_offs = 0x0170,
+		.sram_pdn_bits = GENMASK(8, 8),
+		.sram_pdn_ack_bits = GENMASK(12, 12),
+		.bp_cfg = {
+			BUS_PROT_WR_IGN(INFRA,
+					MT6873_TOP_AXI_PROT_EN_MM_DISP,
+					MT6873_TOP_AXI_PROT_EN_MM_SET,
+					MT6873_TOP_AXI_PROT_EN_MM_CLR,
+					MT6873_TOP_AXI_PROT_EN_MM_STA1),
+			BUS_PROT_WR_IGN(INFRA,
+					MT6873_TOP_AXI_PROT_EN_MM_2_DISP,
+					MT6873_TOP_AXI_PROT_EN_MM_2_SET,
+					MT6873_TOP_AXI_PROT_EN_MM_2_CLR,
+					MT6873_TOP_AXI_PROT_EN_MM_2_STA1),
+			BUS_PROT_WR(INFRA,
+				    MT6873_TOP_AXI_PROT_EN_DISP,
+				    MT6873_TOP_AXI_PROT_EN_SET,
+				    MT6873_TOP_AXI_PROT_EN_CLR,
+				    MT6873_TOP_AXI_PROT_EN_STA1),
+			BUS_PROT_WR(INFRA,
+				    MT6873_TOP_AXI_PROT_EN_MM_DISP_2ND,
+				    MT6873_TOP_AXI_PROT_EN_MM_SET,
+				    MT6873_TOP_AXI_PROT_EN_MM_CLR,
+				    MT6873_TOP_AXI_PROT_EN_MM_STA1),
+			BUS_PROT_WR(INFRA,
+				    MT6873_TOP_AXI_PROT_EN_MM_2_DISP_2ND,
+				    MT6873_TOP_AXI_PROT_EN_MM_2_SET,
+				    MT6873_TOP_AXI_PROT_EN_MM_2_CLR,
+				    MT6873_TOP_AXI_PROT_EN_MM_2_STA1),
+		},
+		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
+	},
 };
 
