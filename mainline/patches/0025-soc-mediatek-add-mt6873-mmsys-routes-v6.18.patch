diff --git a/drivers/soc/mediatek/mt6873-mmsys.h b/drivers/soc/mediatek/mt6873-mmsys.h
new file mode 100644
index 000000000..b93dab40b
--- /dev/null
+++ b/drivers/soc/mediatek/mt6873-mmsys.h
@@ -0,0 +1,45 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __SOC_MEDIATEK_MT6873_MMSYS_H
+#define __SOC_MEDIATEK_MT6873_MMSYS_H
+
+#define MT6873_DISP_OVL0_2L_OUT0_MOUT_EN	0xf18
+#define MT6873_DISP_OVL0_OUT1_MOUT_EN		0xf1c
+#define MT6873_DISP_RDMA0_SEL_IN		0xf2c
+#define MT6873_DISP_RDMA0_SOUT_SEL		0xf30
+#define MT6873_DISP_DITHER0_MOUT_EN		0xf3c
+#define MT6873_DISP_DSI0_SEL_IN			0xf40
+#define MT6873_DISP_OVL2_2L_OUT0_MOUT_EN	0xf4c
+
+static const struct mtk_mmsys_routes mt6873_mmsys_routing_table[] = {
+	{
+		DDP_COMPONENT_OVL0, DDP_COMPONENT_RDMA0,
+		MT6873_DISP_OVL0_OUT1_MOUT_EN, BIT(0), BIT(0)
+	}, {
+		DDP_COMPONENT_OVL0, DDP_COMPONENT_RDMA0,
+		MT6873_DISP_RDMA0_SEL_IN, GENMASK(1, 0), 0
+	}, {
+		DDP_COMPONENT_OVL_2L0, DDP_COMPONENT_RDMA0,
+		MT6873_DISP_OVL0_2L_OUT0_MOUT_EN, BIT(0), BIT(0)
+	}, {
+		DDP_COMPONENT_OVL_2L0, DDP_COMPONENT_RDMA0,
+		MT6873_DISP_RDMA0_SEL_IN, GENMASK(1, 0), 0x3
+	}, {
+		DDP_COMPONENT_OVL_2L2, DDP_COMPONENT_RDMA4,
+		MT6873_DISP_OVL2_2L_OUT0_MOUT_EN, BIT(0), BIT(0)
+	}, {
+		DDP_COMPONENT_RDMA0, DDP_COMPONENT_DSI0,
+		MT6873_DISP_RDMA0_SOUT_SEL, BIT(0), 0
+	}, {
+		DDP_COMPONENT_RDMA0, DDP_COMPONENT_DSI0,
+		MT6873_DISP_DSI0_SEL_IN, GENMASK(1, 0), 0
+	}, {
+		DDP_COMPONENT_DITHER0, DDP_COMPONENT_DSI0,
+		MT6873_DISP_DITHER0_MOUT_EN, BIT(0), BIT(0)
+	}, {
+		DDP_COMPONENT_DITHER0, DDP_COMPONENT_DSI0,
+		MT6873_DISP_DSI0_SEL_IN, GENMASK(1, 0), 0x1
+	}
+};
+
+#endif /* __SOC_MEDIATEK_MT6873_MMSYS_H */
