 	GATE_MTK(CLK_INFRA_AO_SPI0_CG, "infracfg_ao_spi0_cg",
 		 "spi_sel", &infra_ao_cg1_regs, 1,
 		 &mtk_clk_gate_ops_setclr),
@@ -203,6 +244,23 @@ static const struct mtk_gate infra_ao_clks[] = {
