+
+#define GATE_IMP_IIC_WRAP_W(_id, _name, _parent, _shift)		\
+	GATE_MTK_FLAGS(_id, _name, _parent, &imp_iic_wrap_w_cg_regs,	\
+		       _shift, &mtk_clk_gate_ops_setclr,		\
+		       CLK_OPS_PARENT_ENABLE)
