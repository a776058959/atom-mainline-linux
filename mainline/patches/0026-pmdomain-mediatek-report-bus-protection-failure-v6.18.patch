 }
 
+static void scpsys_bus_protect_dump_failure(struct scpsys_domain *pd,
+					    const struct scpsys_bus_prot_data *bpd,
+					    int index)
+{
+	struct scpsys *scpsys = pd->scpsys;
+	struct regmap *sta_regmap = scpsys_bus_protect_get_sta_regmap(pd, bpd);
+	struct regmap *regmap = scpsys_bus_protect_get_regmap(pd, bpd);
+	u32 expected_ack;
+	u32 set_val = 0;
+	u32 clr_val = 0;
+	u32 sta_val = 0;
+	int set_ret;
+	int clr_ret;
+	int sta_ret;
+
+	expected_ack = (bpd->bus_prot_sta_block == BUS_PROT_BLOCK_INFRA_NAO ?
+			bpd->bus_prot_sta_mask : 0);
+	set_ret = regmap_read(regmap, bpd->bus_prot_set, &set_val);
+	clr_ret = regmap_read(regmap, bpd->bus_prot_clr, &clr_val);
+	sta_ret = regmap_read(sta_regmap, bpd->bus_prot_sta, &sta_val);
+
+	dev_err(scpsys->dev,
+		"%s: bus-protection[%d] clear failed: block=%u sta-block=%u mask=%#x sta-mask=%#x flags=%#x\n",
+		pd->genpd.name, index, (unsigned int)bpd->bus_prot_block,
+		(unsigned int)bpd->bus_prot_sta_block,
+		bpd->bus_prot_set_clr_mask, bpd->bus_prot_sta_mask,
+		(unsigned int)bpd->flags);
+	dev_err(scpsys->dev,
+		"%s: bus-protection[%d] regs: set[%#x]=%#x(rc=%d) clr[%#x]=%#x(rc=%d) sta[%#x]=%#x(rc=%d) expected=%#x\n",
+		pd->genpd.name, index, bpd->bus_prot_set, set_val, set_ret,
+		bpd->bus_prot_clr, clr_val, clr_ret, bpd->bus_prot_sta,
+		sta_val, sta_ret, expected_ack);
+}
+
