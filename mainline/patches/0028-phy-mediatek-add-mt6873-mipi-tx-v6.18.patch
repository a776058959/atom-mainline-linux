diff --git a/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6873.c b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6873.c
new file mode 100644
index 000000000..4ffbc0c56
--- /dev/null
+++ b/drivers/phy/mediatek/phy-mtk-mipi-dsi-mt6873.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2015 MediaTek Inc.
+ * Copyright (c) 2021 XiaoMi, Inc.
+ *
+ * MT6873 MIPI TX PLL support, derived from the vendor
+ * drivers/gpu/drm/mediatek/mtk_mipi_tx.c implementation.
+ */
+
+#include "phy-mtk-io.h"
+#include "phy-mtk-mipi-dsi.h"
+
+#define MIPITX_LANE_CON			0x000c
+#define MIPITX_VOLTAGE_SEL		0x0010
+#define MIPITX_PRESERVED		0x0014
+#define MIPITX_PLL_PWR			0x0028
+#define MIPITX_PLL_CON0			0x002c
+#define MIPITX_PLL_CON1			0x0030
+#define MIPITX_PLL_CON4			0x003c
+#define MIPITX_SW_CTRL_CON4		0x0060
+
+#define MIPITX_D2_SW_CTL_EN		0x0144
+#define MIPITX_D0_SW_CTL_EN		0x0244
+#define MIPITX_CK_SW_CTL_EN		0x0344
+#define MIPITX_D1_SW_CTL_EN		0x0444
+#define MIPITX_D3_SW_CTL_EN		0x0544
+
+#define RG_DSI_HSTX_LDO_REF_SEL		GENMASK(9, 6)
+#define RG_DSI_PLL_POSDIV		GENMASK(10, 8)
+#define RG_DSI_PLL_EN			BIT(4)
+#define AD_DSI_PLL_SDM_PWR_ON		BIT(0)
+#define AD_DSI_PLL_SDM_ISO_EN		BIT(1)
+#define DSI_SW_CTL_EN			BIT(0)
+
+static bool mtk_mipi_tx_pll_is_enabled(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+
+	return !!(readl(mipi_tx->regs + MIPITX_PLL_CON1) & RG_DSI_PLL_EN);
+}
+
+static u32 mtk_mipi_tx_get_pcw(unsigned long data_rate, unsigned int ratio)
+{
+	unsigned int pcw;
+	unsigned int pcw_floor;
+
+	/*
+	 * PCW bit 24~31 = floor(pcw)
+	 * PCW bit 16~23 = fractional byte 0
+	 * PCW bit 8~15  = fractional byte 1
+	 * PCW bit 0~7   = fractional byte 2
+	 */
+	pcw = data_rate * ratio / 26;
+	pcw_floor = data_rate * ratio % 26;
+
+	return ((pcw & 0xff) << 24) |
+	       (((256 * pcw_floor / 26) & 0xff) << 16) |
+	       (((256 * (256 * pcw_floor % 26) / 26) & 0xff) << 8) |
+	       ((256 * (256 * (256 * pcw_floor % 26) % 26) / 26) & 0xff);
+}
+
+static int mtk_mipi_tx_pll_enable(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+	void __iomem *base = mipi_tx->regs;
+	u32 rate = mipi_tx->data_rate / 1000000;
+	unsigned int txdiv;
+	unsigned int txdiv0;
+
+	if (mtk_mipi_tx_pll_is_enabled(hw))
+		return 0;
+
+	dev_dbg(mipi_tx->dev, "enable: %u MHz\n", rate);
+
+	if (rate >= 2000) {
+		txdiv = 1;
+		txdiv0 = 0;
+	} else if (rate >= 1000) {
+		txdiv = 2;
+		txdiv0 = 1;
+	} else if (rate >= 500) {
+		txdiv = 4;
+		txdiv0 = 2;
+	} else if (rate > 250) {
+		txdiv = 8;
+		txdiv0 = 3;
+	} else if (rate >= 125) {
+		txdiv = 16;
+		txdiv0 = 4;
+	} else {
+		return -EINVAL;
+	}
+
+	mtk_phy_update_field(base + MIPITX_VOLTAGE_SEL,
+			     RG_DSI_HSTX_LDO_REF_SEL, 9);
+	writel(0, base + MIPITX_PRESERVED);
+	writel(0x00ff12e0, base + MIPITX_PLL_CON4);
+
+	/* Enable bandgap low-pass and core, then drop the fast-charge bit. */
+	writel(0x3fff0180, base + MIPITX_LANE_CON);
+	usleep_range(500, 600);
+	writel(0x3fff0080, base + MIPITX_LANE_CON);
+
+	/* Put all five high-speed lanes into the software-controlled state. */
+	mtk_phy_set_bits(base + MIPITX_D0_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_D1_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_D2_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_D3_SW_CTL_EN, DSI_SW_CTL_EN);
+	mtk_phy_set_bits(base + MIPITX_CK_SW_CTL_EN, DSI_SW_CTL_EN);
+
+	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+	usleep_range(30, 100);
+	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
+
+	writel(mtk_mipi_tx_get_pcw(rate, txdiv), base + MIPITX_PLL_CON0);
+	mtk_phy_update_field(base + MIPITX_PLL_CON1, RG_DSI_PLL_POSDIV,
+			     txdiv0);
+	mtk_phy_set_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_EN);
+
+	usleep_range(50, 100);
+	mtk_phy_set_bits(base + MIPITX_SW_CTRL_CON4, BIT(0));
+
+	return 0;
+}
+
+static void mtk_mipi_tx_pll_disable(struct clk_hw *hw)
+{
+	struct mtk_mipi_tx *mipi_tx = mtk_mipi_tx_from_clk_hw(hw);
+	void __iomem *base = mipi_tx->regs;
+
+	mtk_phy_clear_bits(base + MIPITX_PLL_CON1, RG_DSI_PLL_EN);
+	mtk_phy_clear_bits(base + MIPITX_SW_CTRL_CON4, BIT(0));
+	mtk_phy_set_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_ISO_EN);
+	mtk_phy_clear_bits(base + MIPITX_PLL_PWR, AD_DSI_PLL_SDM_PWR_ON);
+
+	writel(0x3fff0180, base + MIPITX_LANE_CON);
+	writel(0x3fff0100, base + MIPITX_LANE_CON);
+}
+
+static long mtk_mipi_tx_pll_round_rate(struct clk_hw *hw, unsigned long rate,
+				       unsigned long *parent_rate)
+{
+	return clamp_val(rate, 125000000, 2000000000);
+}
+
+static const struct clk_ops mtk_mipi_tx_pll_ops = {
+	.enable = mtk_mipi_tx_pll_enable,
+	.disable = mtk_mipi_tx_pll_disable,
+	.round_rate = mtk_mipi_tx_pll_round_rate,
+	.set_rate = mtk_mipi_tx_pll_set_rate,
+	.recalc_rate = mtk_mipi_tx_pll_recalc_rate,
+};
+
+const struct mtk_mipitx_data mt6873_mipitx_data = {
+	.mppll_preserve = 0,
+	.mipi_tx_clk_ops = &mtk_mipi_tx_pll_ops,
+};
