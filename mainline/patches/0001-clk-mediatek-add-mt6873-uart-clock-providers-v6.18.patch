+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Copyright (c) 2019 MediaTek Inc.
+ */
+
+#ifndef _DT_BINDINGS_CLK_MT6873_H
+#define _DT_BINDINGS_CLK_MT6873_H
+
+/* TOPCKGEN clock IDs needed by the UART and PMIC wrapper chains. */
+#define CLK_TOP_CLK26M			138
+#define CLK_TOP_MUX_UART		29
+#define CLK_TOP_UNIVPLL_D6_D8		101
+#define CLK_TOP_NR_CLK			171
+
+/* APMIXEDSYS clock IDs. */
+#define CLK_APMIXED_UNIVPLL		2
+#define CLK_APMIXED_NR_CLK		14
+
+/* INFRACFG_AO clock IDs needed by PMIC and UART0/UART1. */
+#define CLK_INFRA_AO_PMIC_CG_TMR	1
+#define CLK_INFRA_AO_PMIC_CG_AP		2
+#define CLK_INFRA_AO_UART0_CG		22
+#define CLK_INFRA_AO_UART1_CG		23
+#define CLK_INFRA_AO_NR_CLK		132
+
+#endif /* _DT_BINDINGS_CLK_MT6873_H */
