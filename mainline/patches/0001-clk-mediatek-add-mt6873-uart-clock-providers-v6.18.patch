diff --git a/Documentation/devicetree/bindings/clock/mediatek,mt6873-sys-clock.yaml b/Documentation/devicetree/bindings/clock/mediatek,mt6873-sys-clock.yaml
new file mode 100644
index 000000000..f48a08de8
--- /dev/null
+++ b/Documentation/devicetree/bindings/clock/mediatek,mt6873-sys-clock.yaml
@@ -0,0 +1,69 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/mediatek,mt6873-sys-clock.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek System Clock Controllers for MT6873
+
+maintainers:
+  - Matthias Brugger <matthias.bgg@gmail.com>
+  - AngeloGioacchino Del Regno <angelogioacchino.delregno@collabora.com>
+
+description: |
+  The MT6873 system clock controllers provide PLLs, dividers, muxes and
+  gates for the SoC. New device trees must use the SoC-specific compatible
+  strings. The legacy generic compatible strings are accepted only for
+  firmware-provided MT6873 device trees and are matched by the driver only
+  when the root node identifies the SoC as MT6873.
+
+properties:
+  compatible:
+    oneOf:
+      - items:
+          - enum:
+              - mediatek,mt6873-topckgen
+              - mediatek,mt6873-infracfg_ao
+              - mediatek,mt6873-apmixedsys
+          - const: syscon
+      - items:
+          - enum:
+              - mediatek,topckgen
+              - mediatek,infracfg_ao
+              - mediatek,apmixed
+          - const: syscon
+
+  reg:
+    maxItems: 1
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    topckgen: syscon@10000000 {
+        compatible = "mediatek,mt6873-topckgen", "syscon";
+        reg = <0x10000000 0x1000>;
+        #clock-cells = <1>;
+    };
+
+  - |
+    infracfg_ao: syscon@10001000 {
+        compatible = "mediatek,mt6873-infracfg_ao", "syscon";
+        reg = <0x10001000 0x1000>;
+        #clock-cells = <1>;
+    };
+
+  - |
+    apmixed: syscon@1000c000 {
+        compatible = "mediatek,mt6873-apmixedsys", "syscon";
+        reg = <0x1000c000 0xe00>;
+        #clock-cells = <1>;
+    };
diff --git a/drivers/clk/mediatek/clk-mt6873-apmixedsys.c b/drivers/clk/mediatek/clk-mt6873-apmixedsys.c
new file mode 100644
index 000000000..96d0de4f8
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6873-apmixedsys.c
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6873 APMIXED clock support needed by the UART clock chain.
+ *
+ * Register layout and values are derived from the vendor MT6873 clock
+ * driver. Only UNIVPLL is registered here; this is not a complete
+ * APMIXEDSYS clock driver.
+ */
+
+#include <dt-bindings/clock/mt6873-clk.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "clk-mtk.h"
+#include "clk-pll.h"
+
+#define MT6873_PLL_FMAX		(3800UL * MHZ)
+#define MT6873_PLL_FMIN		(1500UL * MHZ)
+#define MT6873_INTEGER_BITS	8
+
+static const struct mtk_pll_data mt6873_plls[] = {
+	{
+		.id = CLK_APMIXED_UNIVPLL,
+		.name = "univpll",
+		.reg = 0x308,
+		.pwr_reg = 0x314,
+		.en_mask = BIT(0),
+		.pd_reg = 0x30c,
+		.pd_shift = 24,
+		.flags = HAVE_RST_BAR,
+		.rst_bar_mask = BIT(23),
+		.fmin = MT6873_PLL_FMIN,
+		.fmax = MT6873_PLL_FMAX,
+		.pcwbits = 22,
+		.pcwibits = MT6873_INTEGER_BITS,
+		.pcw_reg = 0x30c,
+		.pcw_shift = 0,
+		.pcw_chg_reg = 0,
+		.en_reg = 0,
+	},
+};
+
+static bool clk_mt6873_apmixed_root_is_supported(void)
+{
+	return of_device_is_compatible(of_root, "mediatek,MT6873") ||
+	       of_device_is_compatible(of_root, "mediatek,mt6873");
+}
+
+static int clk_mt6873_apmixed_probe(struct platform_device *pdev)
+{
+	struct device_node *node = pdev->dev.of_node;
+	struct clk_hw_onecell_data *clk_data;
+	int ret;
+
+	if (!clk_mt6873_apmixed_root_is_supported())
+		return -ENODEV;
+
+	clk_data = mtk_alloc_clk_data(CLK_APMIXED_NR_CLK);
+	if (!clk_data)
+		return -ENOMEM;
+
+	ret = mtk_clk_register_plls(&pdev->dev, mt6873_plls,
+				    ARRAY_SIZE(mt6873_plls), clk_data);
+	if (ret)
+		goto free_clk_data;
+
+	ret = of_clk_add_hw_provider(node, of_clk_hw_onecell_get, clk_data);
+	if (ret)
+		goto unregister_plls;
+
+	platform_set_drvdata(pdev, clk_data);
+	return 0;
+
+unregister_plls:
+	mtk_clk_unregister_plls(mt6873_plls, ARRAY_SIZE(mt6873_plls),
+				clk_data);
+free_clk_data:
+	mtk_free_clk_data(clk_data);
+	return ret;
+}
+
+static void clk_mt6873_apmixed_remove(struct platform_device *pdev)
+{
+	struct clk_hw_onecell_data *clk_data = platform_get_drvdata(pdev);
+
+	of_clk_del_provider(pdev->dev.of_node);
+	mtk_clk_unregister_plls(mt6873_plls, ARRAY_SIZE(mt6873_plls),
+				clk_data);
+	mtk_free_clk_data(clk_data);
+}
+
+static const struct of_device_id clk_mt6873_apmixed_of_match[] = {
+	{ .compatible = "mediatek,mt6873-apmixedsys" },
+	{ .compatible = "mediatek,apmixed" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, clk_mt6873_apmixed_of_match);
+
+static struct platform_driver clk_mt6873_apmixed_driver = {
+	.driver = {
+		.name = "clk-mt6873-apmixed",
+		.of_match_table = clk_mt6873_apmixed_of_match,
+	},
+	.probe = clk_mt6873_apmixed_probe,
+	.remove = clk_mt6873_apmixed_remove,
+};
+module_platform_driver(clk_mt6873_apmixed_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6873 APMIXED UART clock support");
+MODULE_LICENSE("GPL");
diff --git a/drivers/clk/mediatek/clk-mt6873.c b/drivers/clk/mediatek/clk-mt6873.c
new file mode 100644
index 000000000..fde3a19ea
--- /dev/null
+++ b/drivers/clk/mediatek/clk-mt6873.c
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * MediaTek MT6873 minimal TOPCKGEN and INFRACFG_AO clock support.
+ *
+ * Register layout and values are derived from the vendor MT6873 clock
+ * driver. This provider intentionally exposes only the clocks needed by
+ * the UART console and PMIC wrapper bring-up:
+ *
+ *   univpll_d6_d8 -> uart_sel -> uart0/1 gate
+ *   clk26m -> f26m_sel -> pmic_tmr/pmic_ap gates
+ *
+ * Unsupported clock IDs remain -ENOENT.
+ */
+
+#include <dt-bindings/clock/mt6873-clk.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include "clk-gate.h"
+#include "clk-mtk.h"
+#include "clk-mux.h"
+
+static DEFINE_SPINLOCK(mt6873_clk_lock);
+
+static const struct mtk_fixed_clk top_fixed_clks[] = {
+	FIXED_CLK(CLK_TOP_CLK26M, "f26m_sel", "clk26m", 26000000),
+};
+
+static const struct mtk_fixed_factor top_divs[] = {
+	FACTOR(CLK_TOP_UNIVPLL_D6_D8, "univpll_d6_d8", "univpll", 1, 48),
+};
+
+static const char * const uart_parents[] = {
+	"clk26m",
+	"univpll_d6_d8",
+};
+
+static const struct mtk_mux top_muxes[] = {
+	MUX_CLR_SET_UPD(CLK_TOP_MUX_UART, "uart_sel", uart_parents,
+			0x70, 0x74, 0x78, 8, 1, 0x004, 25),
+};
+
+static const struct mtk_gate_regs infra_ao_cg_regs = {
+	.sta_ofs = 0x90,
+	.clr_ofs = 0x84,
+	.set_ofs = 0x80,
+};
+
+static const struct mtk_gate infra_ao_clks[] = {
+	GATE_MTK(CLK_INFRA_AO_PMIC_CG_TMR, "infracfg_ao_pmic_cg_tmr",
+		 "f26m_sel", &infra_ao_cg_regs, 0,
+		 &mtk_clk_gate_ops_setclr),
+	GATE_MTK(CLK_INFRA_AO_PMIC_CG_AP, "infracfg_ao_pmic_cg_ap",
+		 "f26m_sel", &infra_ao_cg_regs, 1,
+		 &mtk_clk_gate_ops_setclr),
+	GATE_MTK(CLK_INFRA_AO_UART0_CG, "infracfg_ao_uart0_cg",
+		 "uart_sel", &infra_ao_cg_regs, 22,
+		 &mtk_clk_gate_ops_setclr),
+	GATE_MTK(CLK_INFRA_AO_UART1_CG, "infracfg_ao_uart1_cg",
+		 "uart_sel", &infra_ao_cg_regs, 23,
+		 &mtk_clk_gate_ops_setclr),
+};
+
+/*
+ * The DT clock IDs are sparse. Keep the clk_hw_onecell_data allocation size
+ * separate from the number of clocks in each registration array.
+ */
+struct mt6873_clk_desc {
+	unsigned int num_clk_ids;
+	const struct mtk_fixed_clk *fixed_clks;
+	unsigned int num_fixed_clks;
+	const struct mtk_fixed_factor *factor_clks;
+	unsigned int num_factor_clks;
+	const struct mtk_mux *mux_clks;
+	unsigned int num_mux_clks;
+	const struct mtk_gate *gate_clks;
+	unsigned int num_gate_clks;
+};
+
+static const struct mt6873_clk_desc topck_desc = {
+	.num_clk_ids = CLK_TOP_NR_CLK,
+	.fixed_clks = top_fixed_clks,
+	.num_fixed_clks = ARRAY_SIZE(top_fixed_clks),
+	.factor_clks = top_divs,
+	.num_factor_clks = ARRAY_SIZE(top_divs),
+	.mux_clks = top_muxes,
+	.num_mux_clks = ARRAY_SIZE(top_muxes),
+};
+
+static const struct mt6873_clk_desc infra_ao_desc = {
+	.num_clk_ids = CLK_INFRA_AO_NR_CLK,
+	.gate_clks = infra_ao_clks,
+	.num_gate_clks = ARRAY_SIZE(infra_ao_clks),
+};
+
+static bool clk_mt6873_root_is_supported(void)
+{
+	return of_device_is_compatible(of_root, "mediatek,MT6873") ||
+	       of_device_is_compatible(of_root, "mediatek,mt6873");
+}
+
+static int clk_mt6873_probe(struct platform_device *pdev)
+{
+	const struct mt6873_clk_desc *desc;
+	struct clk_hw_onecell_data *clk_data;
+	struct device_node *node = pdev->dev.of_node;
+	int ret;
+
+	if (!clk_mt6873_root_is_supported())
+		return -ENODEV;
+
+	desc = device_get_match_data(&pdev->dev);
+	if (!desc)
+		return -EINVAL;
+
+	clk_data = mtk_alloc_clk_data(desc->num_clk_ids);
+	if (!clk_data)
+		return -ENOMEM;
+
+	if (desc->fixed_clks) {
+		ret = mtk_clk_register_fixed_clks(desc->fixed_clks,
+						  desc->num_fixed_clks,
+						  clk_data);
+		if (ret)
+			goto free_clk_data;
+	}
+
+	if (desc->factor_clks) {
+		ret = mtk_clk_register_factors(desc->factor_clks,
+					       desc->num_factor_clks, clk_data);
+		if (ret)
+			goto unregister_fixed_clks;
+	}
+
+	if (desc->mux_clks) {
+		ret = mtk_clk_register_muxes(&pdev->dev, desc->mux_clks,
+					     desc->num_mux_clks, node,
+					     &mt6873_clk_lock, clk_data);
+		if (ret)
+			goto unregister_factors;
+	}
+
+	if (desc->gate_clks) {
+		ret = mtk_clk_register_gates(&pdev->dev, node, desc->gate_clks,
+					     desc->num_gate_clks, clk_data);
+		if (ret)
+			goto unregister_muxes;
+	}
+
+	ret = of_clk_add_hw_provider(node, of_clk_hw_onecell_get, clk_data);
+	if (ret)
+		goto unregister_gates;
+
+	platform_set_drvdata(pdev, clk_data);
+	return 0;
+
+unregister_gates:
+	if (desc->gate_clks)
+		mtk_clk_unregister_gates(desc->gate_clks, desc->num_gate_clks,
+					 clk_data);
+unregister_muxes:
+	if (desc->mux_clks)
+		mtk_clk_unregister_muxes(desc->mux_clks, desc->num_mux_clks,
+					 clk_data);
+unregister_factors:
+	if (desc->factor_clks)
+		mtk_clk_unregister_factors(desc->factor_clks,
+					   desc->num_factor_clks, clk_data);
+unregister_fixed_clks:
+	if (desc->fixed_clks)
+		mtk_clk_unregister_fixed_clks(desc->fixed_clks,
+					      desc->num_fixed_clks, clk_data);
+free_clk_data:
+	mtk_free_clk_data(clk_data);
+	return ret;
+}
+
+static void clk_mt6873_remove(struct platform_device *pdev)
+{
+	const struct mt6873_clk_desc *desc;
+	struct clk_hw_onecell_data *clk_data;
+
+	desc = device_get_match_data(&pdev->dev);
+	clk_data = platform_get_drvdata(pdev);
+	if (!desc || !clk_data)
+		return;
+
+	of_clk_del_provider(pdev->dev.of_node);
+	if (desc->gate_clks)
+		mtk_clk_unregister_gates(desc->gate_clks, desc->num_gate_clks,
+					 clk_data);
+	if (desc->mux_clks)
+		mtk_clk_unregister_muxes(desc->mux_clks, desc->num_mux_clks,
+					 clk_data);
+	if (desc->factor_clks)
+		mtk_clk_unregister_factors(desc->factor_clks,
+					   desc->num_factor_clks, clk_data);
+	if (desc->fixed_clks)
+		mtk_clk_unregister_fixed_clks(desc->fixed_clks,
+					      desc->num_fixed_clks, clk_data);
+	mtk_free_clk_data(clk_data);
+}
+
+static const struct of_device_id clk_mt6873_of_match[] = {
+	{ .compatible = "mediatek,mt6873-topckgen", .data = &topck_desc },
+	{ .compatible = "mediatek,mt6873-infracfg_ao",
+	  .data = &infra_ao_desc },
+	{ .compatible = "mediatek,topckgen", .data = &topck_desc },
+	{ .compatible = "mediatek,infracfg_ao", .data = &infra_ao_desc },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, clk_mt6873_of_match);
+
+static struct platform_driver clk_mt6873_driver = {
+	.driver = {
+		.name = "clk-mt6873",
+		.of_match_table = clk_mt6873_of_match,
+	},
+	.probe = clk_mt6873_probe,
+	.remove = clk_mt6873_remove,
+};
+module_platform_driver(clk_mt6873_driver);
+
+MODULE_DESCRIPTION("MediaTek MT6873 minimal UART and PMIC wrapper clocks");
+MODULE_LICENSE("GPL");
