diff --git a/include/dt-bindings/power/mediatek,mt6873-power.h b/include/dt-bindings/power/mediatek,mt6873-power.h
new file mode 100644
index 000000000..f94389066
--- /dev/null
+++ b/include/dt-bindings/power/mediatek,mt6873-power.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause) */
+/*
+ * Values mirror the vendor SCP_SYS DT ABI in mt6873-clk.h. They are
+ * distinct from the clk-mt6873-pg internal enum and intentionally preserve
+ * the vendor numbering so future domains can be mapped without aliases.
+ */
+
+#ifndef _DT_BINDINGS_POWER_MEDIATEK_MT6873_POWER_H
+#define _DT_BINDINGS_POWER_MEDIATEK_MT6873_POWER_H
+
+#define MT6873_POWER_DOMAIN_MD1			1
+#define MT6873_POWER_DOMAIN_CONN		2
+#define MT6873_POWER_DOMAIN_MFG0		3
+#define MT6873_POWER_DOMAIN_MFG1		4
+#define MT6873_POWER_DOMAIN_MFG2		5
+#define MT6873_POWER_DOMAIN_MFG3		6
+#define MT6873_POWER_DOMAIN_MFG4		7
+#define MT6873_POWER_DOMAIN_MFG5		8
+#define MT6873_POWER_DOMAIN_MFG6		9
+#define MT6873_POWER_DOMAIN_ISP			10
+#define MT6873_POWER_DOMAIN_ISP2		11
+#define MT6873_POWER_DOMAIN_IPE			12
+#define MT6873_POWER_DOMAIN_VDEC		13
+#define MT6873_POWER_DOMAIN_VDEC2		14
+#define MT6873_POWER_DOMAIN_VENC		15
+#define MT6873_POWER_DOMAIN_MDP			16
+#define MT6873_POWER_DOMAIN_DIS			17
+#define MT6873_POWER_DOMAIN_AUDIO		18
+#define MT6873_POWER_DOMAIN_ADSP		19
+#define MT6873_POWER_DOMAIN_CAM			20
+#define MT6873_POWER_DOMAIN_CAM_RAWA		21
+#define MT6873_POWER_DOMAIN_CAM_RAWB		22
+#define MT6873_POWER_DOMAIN_CAM_RAWC		23
+#define MT6873_POWER_DOMAIN_DP_TX		24
+#define MT6873_POWER_DOMAIN_MSDC		25
+#define MT6873_POWER_DOMAIN_VPU			26
+
+#endif /* _DT_BINDINGS_POWER_MEDIATEK_MT6873_POWER_H */
