diff --git a/drivers/pmdomain/mediatek/mt6873-pm-domains.h b/drivers/pmdomain/mediatek/mt6873-pm-domains.h
new file mode 100644
index 000000000..d8b86a642
--- /dev/null
+++ b/drivers/pmdomain/mediatek/mt6873-pm-domains.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+#ifndef __SOC_MEDIATEK_MT6873_PM_DOMAINS_H
+#define __SOC_MEDIATEK_MT6873_PM_DOMAINS_H
+
+#include "mtk-pm-domains.h"
+#include <dt-bindings/power/mediatek,mt6873-power.h>
+
+/*
+ * MT6873 power-domain support.
+ *
+ * Only CONN is described here for now. The vendor MT6873 power driver has no
+ * pre-clock for CONN, and CONN must stay default-off until its consumers are
+ * brought up. Other domains require their real MT6873 clock providers first;
+ * do not reuse MT8192 domain clocks merely because the register offsets match.
+ */
+static enum scpsys_bus_prot_block scpsys_bus_prot_blocks_mt6873[] = {
+	BUS_PROT_BLOCK_INFRA
+};
+
+static const struct scpsys_domain_data scpsys_domain_data_mt6873[] = {
+	[MT6873_POWER_DOMAIN_CONN] = {
+		.name = "conn",
+		.sta_mask = BIT(1),
+		.ctl_offs = 0x0304,
+		.pwr_sta_offs = 0x016c,
+		.pwr_sta2nd_offs = 0x0170,
+		.sram_pdn_bits = 0,
+		.sram_pdn_ack_bits = 0,
+		.bp_cfg = {
+			BUS_PROT_WR(INFRA,
+				    MT6873_TOP_AXI_PROT_EN_CONN,
+				    MT6873_TOP_AXI_PROT_EN_SET,
+				    MT6873_TOP_AXI_PROT_EN_CLR,
+				    MT6873_TOP_AXI_PROT_EN_STA1),
+			BUS_PROT_WR(INFRA,
+				    MT6873_TOP_AXI_PROT_EN_CONN_2ND,
+				    MT6873_TOP_AXI_PROT_EN_SET,
+				    MT6873_TOP_AXI_PROT_EN_CLR,
+				    MT6873_TOP_AXI_PROT_EN_STA1),
+			BUS_PROT_WR(INFRA,
+				    MT6873_TOP_AXI_PROT_EN_1_CONN,
+				    MT6873_TOP_AXI_PROT_EN_1_SET,
+				    MT6873_TOP_AXI_PROT_EN_1_CLR,
+				    MT6873_TOP_AXI_PROT_EN_1_STA1),
+		},
+		.caps = MTK_SCPD_KEEP_DEFAULT_OFF,
+	},
+};
+
+static const struct scpsys_soc_data mt6873_scpsys_data = {
+	.domains_data = scpsys_domain_data_mt6873,
+	.num_domains = ARRAY_SIZE(scpsys_domain_data_mt6873),
+	.bus_prot_blocks = scpsys_bus_prot_blocks_mt6873,
+	.num_bus_prot_blocks = ARRAY_SIZE(scpsys_bus_prot_blocks_mt6873),
+};
+
+#endif /* __SOC_MEDIATEK_MT6873_PM_DOMAINS_H */
